# ---------------------------------------------------------------------------
# iMaVote — Environment Variables
# Copy this file to `.env.local` and fill in the values.
# ---------------------------------------------------------------------------

# Public (bundled into the browser)
# The deployed VotingCore contract address the UI should read from.
NEXT_PUBLIC_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Default chain id the UI should target (11155111 = Sepolia, 31337 = Hardhat).
NEXT_PUBLIC_CHAIN_ID=11155111

# Optional — improves RPC reliability on Sepolia & Mainnet.
NEXT_PUBLIC_ALCHEMY_KEY=

# Optional — required to enable the WalletConnect connector.
NEXT_PUBLIC_WC_PROJECT_ID=

# ---------------------------------------------------------------------------
# Private (server / deployment only, never sent to the browser)
# ---------------------------------------------------------------------------

# Deployer private key for `npm run deploy:sepolia`.
PRIVATE_KEY=

# Used by `hardhat verify` after a public deployment.
ETHERSCAN_API_KEY=
